#!/usr/bin/env nix-shell
#!nix-shell -p ruby -i ruby

# This script is expected to be used to copy back the `kernel-builder` built
# linux configuration to the kernel's source directory.
#
# Use this to normalize the configuration after:
#
#  - Changing configuration options
#  - Changing the kernel version

require "shellwords"
ROOT = File.join(__dir__, "..")

# Translate nix store path to source path
# /nix/store/xxx/path/to/file -> /repo/root/path/to/file
def store_to_source(path)
  if path.match(%r{^/nix/store/[^/]+/})
    # Extract the relative path after the store hash
    relative = path.sub(%r{^/nix/store/[^/]+/}, "")
    result = File.join(ROOT, relative)
    $stderr.puts "DEBUG: Translated #{path} -> #{result}" if ENV['DEBUG']
    result
  else
    path
  end
end

def usage()
  puts "Usage: bin/kernel-normalize-config [--file=config.path] --only-check <device_name>"
  puts ""
  puts " --file=path/to/kernel/config.file -- detected automatically if not present."
  puts " --only-check"
  puts " --also-commit"
end

FAMILIES_DIR = File.absolute_path(File.join(__dir__(), "..", "/devices/families/"))

# Poor approximation to arguments parsing.
params, other_args = ARGV.partition { |s| s.match(/^--/) }

if other_args.empty?
  $stderr.puts "Device name required."
  usage
  exit 1
end

# Somewhat embarassing parameter parsing
params = params.map do |param|
  k, v = param.split("=", 2)
  v = true unless v
  k = k.sub(/^--/, "")
  [k, v]
end.to_h

ONLY_CHECK =
  if params["only-check"] then
    true
    params.delete("only-check")
  else
    false
  end

ALSO_COMMIT =
  if params["also-commit"] then
    true
    params.delete("also-commit")
  else
    false
  end

DEVICE = other_args.shift

# Build the flake attribute path for the device
def flake_attr(device)
  # Handle path-based devices
  device_name = device.sub(%r{/+$}, "").split("/").last
  ".#packages.eval.#{device_name}"
end

FLAKE_ATTR = flake_attr(DEVICE)

@file =
  if params["file"]
    params.delete("file")
  end

unless params.empty?
  $stderr.puts "Unknown parameters #{params.keys.join(", ")}."
  usage
  exit 1
end

unless other_args.empty?
  $stderr.puts "Unexpected arguments #{other_args.join(", ")}."
  usage
  exit 1
end

unless ONLY_CHECK
  unless @file
    $stderr.puts "\nGetting config file path to update..."
    
    # Construct source path directly - avoid Nix store paths
    deviceConfig = File.join(ROOT, "devices", DEVICE, "kernel", "config.aarch64")
    
    # Check if device has its own config, otherwise look in families
    if File.exist?(deviceConfig)
      @file = deviceConfig
    else
      # Check common family locations
      families = ["sdm845-mainline", "sdm845", "mainline"]
      families.each do |family|
        familyConfig = File.join(ROOT, "devices", "families", family, "kernel", "config.aarch64")
        if File.exist?(familyConfig)
          @file = familyConfig
          break
        end
      end
    end
  end

  unless @file and File.exist?(@file)
    $stderr.puts "Kernel config file not found."
    $stderr.puts "Please provide path to the config file with `--file=...`."
    $stderr.puts
    usage
    exit 1
  end

  unless @file
    $stderr.puts "Could not find kernel configuration file for #{DEVICE}."
    usage
    exit 1
  end

  $stderr.puts "\nNOTE: This will update '#{@file}'\n\n"
  
  # Debug: show the translated path
  $stderr.puts "Source path: #{@file}"
  $stderr.puts "File exists: #{File.exist?(@file)}"
  $stderr.puts "File writable: #{File.writable?(@file) rescue false}"
end

result = `#{[
  "nix", "build",
  "--impure",
  "--no-link",
  "--print-out-paths",
  "#{FLAKE_ATTR}.config.mobile.boot.stage-1.kernel.package.#{ONLY_CHECK ? "validatedConfig" : "normalizedConfig"}",
].shelljoin}`.strip

unless $?.success?
  $stderr.puts "ERROR: nix build failed!"
  exit 1
end

if ONLY_CHECK
  $stderr.puts "Configuration passed."
  exit 0
end

unless result and File.exist?(result)
  $stderr.puts "ERROR: Build result not found at: #{result}"
  exit 1
end

# We "cat" into the file to ensure we don't copy the store path access rights.
File.write(@file, File.read(result))

if ALSO_COMMIT
  device_name =
    if @file.match?(%r{^#{FAMILIES_DIR}})
      @file.split("/")[-3]
    else
      DEVICE.split("/").last
    end
  message = "#{device_name}: Normalize kernel config\n\n(Automatically using bin/kernel-normalize-all)"
  system("git", "commit", "-m", message, "--", @file)
end

# vim: ft=ruby
