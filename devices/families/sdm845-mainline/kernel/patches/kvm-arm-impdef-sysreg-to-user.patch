+/*
+ * Complete an IMPLEMENTATION DEFINED system register access that was handed to
+ * userspace via KVM_EXIT_ARM_SYSREG. Mirrors kvm_handle_mmio_return(): the VMM
+ * has either emulated the register -- supplying the value for a read -- or
+ * asked us to make the guest see an undefined instruction instead.
+ */
+static int kvm_handle_impdef_sysreg_return(struct kvm_vcpu *vcpu)
+{
+	struct kvm_run *run = vcpu->run;
+
+	if (!vcpu->arch.impdef_sysreg.pending)
+		return 1;
+
+	vcpu->arch.impdef_sysreg.pending = false;
+
+	if (run->arm_sysreg.error) {
+		kvm_inject_undefined(vcpu);
+		return 1;
+	}
+
+	if (!vcpu->arch.impdef_sysreg.is_write)
+		vcpu_set_reg(vcpu, vcpu->arch.impdef_sysreg.rt,
+			     run->arm_sysreg.data);
+
+	kvm_incr_pc(vcpu);
+	return 1;
+}
