+/*
+ * Hand an IMPLEMENTATION DEFINED system register access to userspace.
+ *
+ * HCR_EL2.TIDCP traps EL1 accesses to the encodings the architecture reserves
+ * for IMPLEMENTATION DEFINED functionality (Op0 == 3 with CRn == 11 or 15).
+ * KVM cannot know what a given implementer put there, so it would inject an
+ * undefined instruction -- fatal for a guest whose kernel drives SoC-specific
+ * registers. An emulated Apple SoC running its own firmware, for instance,
+ * dies on its very first APCTL_EL1 (s3_4_c15_c0_4) read, long before it can
+ * print anything.
+ *
+ * The VMM already models these registers -- it has to, to emulate the SoC
+ * under a pure emulator -- so hand the access out and let it answer. Note the
+ * trap is keyed on the *encoding space*, which is architectural: this works
+ * whether or not the host CPU implements the register, so a guest expecting
+ * one vendor's registers can run on another vendor's silicon.
+ */
+static bool kvm_impdef_sysreg_to_user(struct kvm_vcpu *vcpu, u64 esr, int Rt)
+{
+	struct sys_reg_params p = esr_sys64_to_params(esr);
+	struct kvm_run *run = vcpu->run;
+
+	if (!test_bit(KVM_ARCH_FLAG_IMPDEF_SYSREG_TO_USER,
+		      &vcpu->kvm->arch.flags))
+		return false;
+
+	if (p.Op0 != 3 || (p.CRn != 11 && p.CRn != 15))
+		return false;
+
+	run->exit_reason = KVM_EXIT_ARM_SYSREG;
+	run->arm_sysreg.error = 0;
+	run->arm_sysreg.is_write = p.is_write;
+	run->arm_sysreg.esr = esr;
+	run->arm_sysreg.data = p.is_write ? vcpu_get_reg(vcpu, Rt) : 0;
+
+	vcpu->arch.impdef_sysreg.pending = true;
+	vcpu->arch.impdef_sysreg.is_write = p.is_write;
+	vcpu->arch.impdef_sysreg.rt = Rt;
+
+	return true;
+}
