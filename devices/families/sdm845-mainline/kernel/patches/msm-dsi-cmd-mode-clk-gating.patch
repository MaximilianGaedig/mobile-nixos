+	 * link_clk_disable() underflows the clk refcount, which splats in
+	 * dsi_link_clk_disable_6g() and leaves the panel wedged with the
+	 * clocks already off by the time power_off() runs.
+	 */
+	if (!msm_host->clk_gated || msm_host->frame_clk_on)
+		return;
