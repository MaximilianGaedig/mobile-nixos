+	if (!msm_host->clk_gated || !msm_host->frame_clk_on)
+		return;
+
+	msm_host->frame_clk_on = false;
+	msm_host->cfg_hnd->ops->link_clk_disable(msm_host);
+	pm_runtime_put(&msm_host->pdev->dev);
+}
