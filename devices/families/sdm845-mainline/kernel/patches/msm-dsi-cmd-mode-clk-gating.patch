+/*
+ * Command-mode inter-frame clock gating: bracket each frame so the DSI host
+ * only holds its runtime-PM reference (and its link clocks) while pixels are
+ * actually in flight. Between frames it can suspend, releasing mdss_gdsc and
+ * with it the CX rail. No-ops unless the DSI side actually gated (opt-in via
+ * the msm_dsi cmd_mode_clk_gating module parameter).
+ */
+static struct msm_dsi *_dpu_encoder_get_dsi(struct drm_encoder *drm_enc)
+{
+	struct msm_drm_private *priv;
+	struct dpu_encoder_virt *dpu_enc;
+	const struct msm_display_info *disp_info;
+	int index;
+
+	if (!drm_enc || !drm_enc->dev || !drm_enc->dev->dev_private)
+		return NULL;
+
+	priv = drm_enc->dev->dev_private;
+	dpu_enc = to_dpu_encoder_virt(drm_enc);
+	disp_info = &dpu_enc->disp_info;
+	index = disp_info->h_tile_instance[0];
+
+	if (disp_info->intf_type != INTF_DSI)
+		return NULL;
+	if (!priv->kms || index >= ARRAY_SIZE(priv->kms->dsi))
+		return NULL;
+
+	return priv->kms->dsi[index];
+}
+
+void dpu_encoder_dsi_kickoff_prepare(struct drm_encoder *drm_enc)
+{
+	msm_dsi_kickoff_prepare(_dpu_encoder_get_dsi(drm_enc));
+}
+
+void dpu_encoder_dsi_kickoff_complete(struct drm_encoder *drm_enc)
+{
+	msm_dsi_kickoff_complete(_dpu_encoder_get_dsi(drm_enc));
+}
